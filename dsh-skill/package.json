    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "26.1.0",
    "lucide-react": "^1.31.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-group": "1.0.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill-manager",
    "skills"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "homepage": "https://github.com/DigiStrique-Solutions/dsh-skills-manager-secure#readme",
  "bugs": {
    "url": "https://github.com/DigiStrique-Solutions/dsh-skills-manager-secure/issues"
