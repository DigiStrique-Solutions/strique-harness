{
  "name": "@strique/dsh-branding",
  "version": "0.1.12",
  "description": "Strique visual identity and marketing persona for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./persona": {
      "types": "./lib/persona.d.ts",
      "default": "./lib/persona.js"
    }
  },
  "files": [
    "assets/**",
    "prompts/**",
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && pnpm run bundle:verify",
    "bundle:verify": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts tsdown.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "react": ">=18.2.0 <19.0.0",
    "react-dom": ">=18.2.0 <19.0.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "20.8.9",
    "oxlint": "1.76.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-modules": "0.2.1-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "yaml": "2.9.0",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.5-alpha.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "branding",
    "deepseek-harness",
    "dsh-plugin",
    "strique"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
