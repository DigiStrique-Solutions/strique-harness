{
  "name": "dsh-mcp-manager-secure",
  "description": "Authenticated MCP server management with approved workspace configurations and isolated credentials",
  "version": "0.9.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "mcp",
    "model-context-protocol",
    "oauth",
    "stdio",
    "dsh-plugin",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigiStrique-Solutions/strique-dsh-mcp-client.git"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "types": "lib/index.d.ts",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "homepage": "https://github.com/DigiStrique-Solutions/strique-dsh-mcp-client#readme",
  "bugs": {
    "url": "https://github.com/DigiStrique-Solutions/strique-dsh-mcp-client/issues"
  }
}
